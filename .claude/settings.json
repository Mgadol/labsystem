{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cd /home/user/labsystem && git pull --rebase origin claude/adoring-hamilton-wdvj0b 2>/dev/null || true && python app.py &",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
